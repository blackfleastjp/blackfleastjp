{
  "name": "lifter-erp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "concurrently \"npm run dev --workspace @lifter-erp/api\" \"npm run dev --workspace @lifter-erp/web\"",
    "build": "npm run prisma:generate && npm run build --workspace @lifter-erp/api && npm run build --workspace @lifter-erp/web",
    "prisma:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "lint": "eslint \"apps/**/*.{ts,tsx}\"",
    "typecheck": "npm run typecheck --workspace @lifter-erp/api && npm run typecheck --workspace @lifter-erp/web",
    "test": "npm run test --workspace @lifter-erp/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace @lifter-erp/api",
    "db:migrate": "npm run db:migrate --workspace @lifter-erp/api",
    "db:deploy": "npm run db:deploy --workspace @lifter-erp/api",
    "db:seed": "npm run db:seed --workspace @lifter-erp/api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "~5.5.4"
  }
}
