generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BackgroundJobType {
  COMPANY_BACKUP
  COMPANY_RESTORE
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique @db.VarChar(320)
  name                String               @db.VarChar(160)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  companyId           String?              @map("company_id")
  employeeCode        String?              @map("employee_code") @db.VarChar(80)
  department          String?              @db.VarChar(120)
  designation         String?              @db.VarChar(120)
  mobile              String?              @db.VarChar(20)
  alternateEmail      String?              @map("alternate_email") @db.VarChar(320)
  dateOfJoining       DateTime?            @map("date_of_joining") @db.Date
  isActive            Boolean              @default(true) @map("is_active")
  emailVerifiedAt     DateTime?            @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  homeCompany         Company?             @relation("HomeCompany", fields: [companyId], references: [id], onDelete: SetNull)
  companyRoles        UserCompanyRole[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  loginEvents         LoginEvent[]
  passwordResetTokens PasswordResetToken[]
  requestedJobs       BackgroundJob[]

  @@unique([companyId, employeeCode])
  @@index([isActive, email])
  @@index([companyId, isActive, name])
  @@map("users")
}

model Company {
  id                   String            @id @default(cuid())
  name                 String            @db.VarChar(180)
  code                 String            @unique @db.VarChar(32)
  legalName            String?           @map("legal_name") @db.VarChar(240)
  address              String?           @db.VarChar(500)
  city                 String?           @db.VarChar(120)
  state                String?           @db.VarChar(120)
  pincode              String?           @db.VarChar(10)
  country              String            @default("IN") @db.Char(2)
  gstin                String?           @unique @db.Char(15)
  pan                  String?           @unique @db.Char(10)
  email                String?           @db.VarChar(320)
  phone                String?           @db.VarChar(20)
  logo                 String?           @db.VarChar(2048)
  financialYearStart   DateTime?         @map("financial_year_start") @db.Date
  financialYearEnd     DateTime?         @map("financial_year_end") @db.Date
  booksBeginningDate   DateTime?         @map("books_beginning_date") @db.Date
  baseCurrency         String            @default("INR") @map("base_currency") @db.Char(3)
  currency             String            @default("INR") @db.Char(3)
  timezone             String            @default("Asia/Kolkata") @db.VarChar(80)
  featureConfiguration Json              @default("{}") @map("feature_configuration")
  isActive             Boolean           @default(true) @map("is_active")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?         @map("deleted_at") @db.Timestamptz(3)
  homeUsers            User[]            @relation("HomeCompany")
  userRoles            UserCompanyRole[]
  roles                Role[]
  auditLogs            AuditLog[]
  backgroundJobs       BackgroundJob[]

  @@index([isActive, name])
  @@index([deletedAt, isActive])
  @@map("companies")
}

model Role {
  id          String            @id @default(cuid())
  companyId   String?           @map("company_id")
  name        String            @db.VarChar(100)
  description String?           @db.VarChar(500)
  isSystem    Boolean           @default(false) @map("is_system")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  company     Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserCompanyRole[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(120)
  name        String           @db.VarChar(120)
  module      String           @db.VarChar(80)
  action      String           @db.VarChar(80)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@unique([module, action])
  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserCompanyRole {
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  isActive  Boolean  @default(true) @map("is_active")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, companyId, roleId])
  @@index([companyId, userId])
  @@index([roleId])
  @@map("user_company_roles")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by")
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt, expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  companyId  String?  @map("company_id")
  action     String   @db.VarChar(100)
  module     String?  @db.VarChar(80)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  metadata   Json     @default("{}")
  requestId  String?  @map("request_id") @db.VarChar(100)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String   @db.VarChar(320)
  succeeded Boolean
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("login_events")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([usedAt, expiresAt])
  @@map("password_reset_tokens")
}

model BackgroundJob {
  id          String              @id @default(cuid())
  companyId   String              @map("company_id")
  requestedBy String              @map("requested_by")
  type        BackgroundJobType
  status      BackgroundJobStatus @default(QUEUED)
  payload     Json                @default("{}")
  result      Json?
  error       String?             @db.VarChar(1000)
  startedAt   DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?           @map("finished_at") @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester   User                @relation(fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("background_jobs")
}
